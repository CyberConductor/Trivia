<Window x:Class="SimpleWpfGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simple WPF GUI" Height="300" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0FF"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Login" Width="200" Height="40"
                    Background="LightBlue" FontWeight="Bold" FontSize="14"
                    Margin="0 0 0 10" />

            <Button Content="Register" Width="200" Height="40"
        Background="LightGreen" FontWeight="Bold" FontSize="14"
        Margin="0 0 0 10"
        Click="RegisterButton_Click" />


            <Button Content="Exit" Width="200" Height="40"
                    Background="Salmon" FontWeight="Bold" FontSize="14" />
        </StackPanel>
    </Grid>
</Window>
