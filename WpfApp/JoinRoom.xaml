<Window x:Class="WpfApp.JoinRoom"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Join Room" Height="500" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Available Rooms" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>

        <ListBox Name="RoomsListBox" Grid.Row="1" DisplayMemberPath="roomName" />

        <Button Content="Join Selected Room" Grid.Row="2" Height="40" Width="200" 
                HorizontalAlignment="Center" Margin="0 10"
                Click="JoinRoomButton_Click"/>
    </Grid>
</Window>
