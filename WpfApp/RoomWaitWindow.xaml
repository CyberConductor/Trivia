<Window x:Class="WpfApp.RoomWaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room Wait"
        Height="400"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- New row for Leave button -->
        </Grid.RowDefinitions>

        <!-- Admin Display -->
        <TextBlock x:Name="AdminTextBlock"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,10"
                   HorizontalAlignment="Center"/>

        <!-- Player List -->
        <ListBox x:Name="PlayersListBox"
                 Grid.Row="1"
                 FontSize="16"
                 Margin="0,10"/>

        <!-- Admin Buttons (Start/Close) -->
        <StackPanel x:Name="AdminControlsPanel"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Margin="0,20,0,0">
            <Button Content="Start Game"
                    Width="100"
                    Margin="10,0"
                    Click="StartGameButton_Click"/>

            <Button Content="Close Room"
                    Width="100"
                    Margin="10,0"
                    Click="CloseRoomButton_Click"/>
        </StackPanel>


        <Button x:Name="LeaveRoomButton"
        Content="Leave Room"
        Grid.Row="3"
        Width="120"
        HorizontalAlignment="Center"
        Margin="0,20,0,0"
        Click="LeaveRoomButton_Click"/>
    </Grid>
</Window>
