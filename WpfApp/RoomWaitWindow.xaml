<Window x:Class="WpfApp.RoomWaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waiting Room" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <TextBlock Text="Players in room:" FontSize="16" FontWeight="Bold"/>
        <ListBox x:Name="PlayersListBox" Margin="0,30,0,0" />
    </Grid>
</Window>