<Window x:Class="WpfApp1.HighScore"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="High Scores"
        Height="450"
        Width="600"
        Background="#f0f4f8"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TextBlock with Title -->
        <TextBlock Text="🏆 High Scores"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#2c3e50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Arrow Back Button -->
        <Button Grid.Row="0"
                Width="50"
                Height="50"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="BackButton_Click"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="0,0,0,20">
            <!-- Left Arrow Icon -->
            <Button.Content>
                <Path Data="M15,0 L0,15 L15,30 Z" 
                      Fill="#3498db" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center" 
                      Stroke="Transparent" 
                      StrokeThickness="2" 
                      RenderTransformOrigin="0.5,0.5" />
            </Button.Content>
        </Button>

        <!-- ListView for Scores -->
        <ListView x:Name="ScoresListView"
                  Grid.Row="1"
                  AlternationCount="2"
                  BorderThickness="1"
                  BorderBrush="#ccc"
                  Background="White"
                  Margin="0,0,0,20"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListView.Resources>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#2c3e50"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#ddd"/>
                    <Style.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#eaf3ff"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#d0e8ff"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Username" Width="300" DisplayMemberBinding="{Binding Username}"/>
                    <GridViewColumn Header="Score" Width="200" DisplayMemberBinding="{Binding Score}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Close Button -->
        <Button Content="Close"
                Grid.Row="2"
                Width="100"
                Height="35"
                HorizontalAlignment="Right"
                Background="#3498db"
                Foreground="White"
                FontWeight="Bold"
                BorderBrush="#2980b9"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
