<Window x:Class="WpfApp.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="83*"/>
            <ColumnDefinition Width="69*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Question -->
            <RowDefinition Height="*"/>
            <!-- Answers -->
            <RowDefinition Height="Auto"/>
            <!-- Submit -->
            <RowDefinition Height="Auto"/>
            <!-- Timer (optional) -->
        </Grid.RowDefinitions>

        <!-- Question Text -->
        <TextBlock x:Name="QuestionTextBlock"
                   FontSize="24"
                   FontWeight="Bold"
                   TextWrapping="Wrap"
                   Grid.Row="0"
                   Margin="0,0,0,20"
                   Text="Question will appear here" Grid.ColumnSpan="2"/>

        <!-- Answers List -->
        <ListBox x:Name="AnswersListBox"
                 Grid.Row="1"
                 FontSize="18"
                 SelectionMode="Single"
                 Margin="0,0,0,20"
                 HorizontalContentAlignment="Left" Grid.ColumnSpan="2"/>

        <!-- Submit Button -->
        <Button x:Name="SubmitAnswerButton"
                Grid.Row="2"
                Content="Submit Answer"
                Width="150"
                Height="40"
                HorizontalAlignment="Left"
                Click="SubmitAnswerButton_Click" Grid.ColumnSpan="2" Margin="305,0,0,41" Grid.RowSpan="2"/>

        <!-- Optional Timer Display -->
        <TextBlock x:Name="TimerTextBlock"
                   Grid.Row="3"
                   HorizontalAlignment="Left"
                   FontSize="16"
                   FontStyle="Italic"
                   Foreground="Gray"
                   Margin="380,20,0,0"
                   Text=""/>
    </Grid>
</Window>
