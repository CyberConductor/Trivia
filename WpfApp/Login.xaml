<Window x:Class="WpfApp.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Login" Height="450" Width="800" Background="#f2f2f2" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <!-- טופס הרשמה -->
        <Border Background="White" CornerRadius="10" Padding="30" Width="350" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <StackPanel>
                <TextBlock Text="Welcome Back!" FontSize="24" FontWeight="Bold" Foreground="#333" Margin="0 0 0 20" HorizontalAlignment="Center"/>

                <TextBox 
                    x:Name="UsernameBox"
                    Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                    materialDesign:HintAssist.Hint="Username"
                    Margin="0 8"
                    FontSize="14"
                    BorderThickness="2"
                    BorderBrush="LightGray"
                    Padding="8"
                />

                <PasswordBox 
                    x:Name="PasswordBox"
                    Style="{StaticResource MaterialDesignFloatingHintPasswordBox}"
                    materialDesign:HintAssist.Hint="Password"
                    Margin="0 10"
                    FontSize="14"
                    BorderThickness="2"
                    BorderBrush="LightGray"
                    Padding="8"
                />


                <Button 
                    Content="Login"
                    Click="LoginButton_Click"
                    Margin="0 25 0 0"
                    Padding="7"
                    Background="SteelBlue"
                    Foreground="White"
                    BorderBrush="Transparent"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                />
                <Button 
                    Content="SignUp"
                    Click="SignUp_Click"
                    Margin="0 10 0 0"
                    Padding="7"
                    Background="Transparent"
                    Foreground="SteelBlue"
                    BorderBrush="SteelBlue"
                    BorderThickness="1"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                />


                <TextBlock x:Name="StatusTextBlock"
                           Margin="0 20 0 0"
                           Foreground="Red"
                           FontSize="12"
                           TextAlignment="Center"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
