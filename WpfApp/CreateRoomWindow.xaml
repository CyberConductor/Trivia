<Window x:Class="WpfApp1.CreateRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Room" Height="350" Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="300">

            <TextBlock Text="Create Room"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <!-- Room Name -->
            <TextBlock Text="Enter Room Name" FontWeight="SemiBold"/>
            <TextBox Name="RoomNameTextBox" Height="25" Margin="0,5,0,15"/>

            <!-- Time per Question -->
            <TextBlock Text="Time per Question (seconds)" FontWeight="SemiBold"/>
            <TextBox Name="QuestionTimeTextBox" Height="25" Margin="0,5,0,15"/>

            <!-- Number of Players -->
            <TextBlock Text="Number of Players" FontWeight="SemiBold"/>
            <TextBox Name="PlayersCountTextBox" Height="25" Margin="0,5,0,20"/>

            <!-- Create Room Button -->
            <Button Content="Create Room"
                    Name="CreateRoomButton"
                    Height="30"
                    Width="120"
                    HorizontalAlignment="Center"
                    Click="CreateRoomButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
