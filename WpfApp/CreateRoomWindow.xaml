<Window x:Class="WpfApp1.CreateRoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Room" Height="400" Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <!-- Back Arrow Button (Top-Left corner) -->
        <Button Name="BackArrowButton"
                Height="35"
                Width="35"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="BackArrowButton_Click"
                Margin="0,0,0,0">
            <Button.Content>
                <!-- Left Arrow Icon -->
                <Path Data="M10,0 L0,5 L10,10 Z"
                      Fill="Black"
                      Width="15"
                      Height="15"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
            </Button.Content>
        </Button>

        <!-- Center Content (Create Room Form) -->
        <StackPanel HorizontalAlignment="Center" Width="300" VerticalAlignment="Center">
            <!-- Title -->
            <TextBlock Text="Create Room"
                       HorizontalAlignment="Center"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20" />

            <!-- Room Name -->
            <TextBlock Text="Enter Room Name" FontWeight="Bold"/>
            <TextBox Name="RoomNameTextBox" Height="30" Margin="0,5,0,15"/>

            <!-- Time per Question -->
            <TextBlock Text="Time per Question (seconds)" FontWeight="Bold"/>
            <TextBox Name="QuestionTimeTextBox" Height="30" Margin="0,5,0,15"/>

            <!-- Number of Players -->
            <TextBlock Text="Number of Players" FontWeight="Bold"/>
            <TextBox Name="PlayersCountTextBox" Height="30" Margin="0,5,0,20"/>

            <!-- Create Room Button -->
            <Button Content="Create Room"
                    Name="CreateRoomButton"
                    Height="35"
                    Width="120"
                    HorizontalAlignment="Center"
                    Click="CreateRoomButton_Click"
                    Margin="0,10,0,10"/>
        </StackPanel>
    </Grid>
</Window>
