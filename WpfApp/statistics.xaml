<Window x:Class="WpfApp.Statistics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistics Menu" Height="250" Width="300"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="200">

            <TextBlock Text="Statistics Menu"
                       FontSize="20"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <!-- Personal Statistics Button -->
            <Button Name="PersonalStatsButton"
                    Content="Personal Statistics"
                    Height="40"
                    Width="180"
                    Margin="0,0,0,10"
                    Click="PersonalStatsButton_Click"/>

            <!-- High Scores Table Button -->
            <Button Name="HighScoresButton"
                    Content="High Scores Table"
                    Height="40"
                    Width="180"
                    Click="HighScoresButton_Click"/>

        </StackPanel>
    </Grid>
</Window>
