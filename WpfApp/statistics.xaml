<Window x:Class="WpfApp.Statistics"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Statistics Menu" Height="300" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#f7f9fc">

    <Grid Margin="20">
        <Border CornerRadius="10" Background="White" Padding="20" BorderBrush="#cccccc" BorderThickness="1" >
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="220">

                <!-- Title -->
                <TextBlock Text="📊 Statistics Menu"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#2c3e50"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Personal Statistics Button -->
                <Button Name="PersonalStatsButton"
                        Content="Personal Statistics"
                        Height="40"
                        Width="200"
                        Margin="0,0,0,10"
                        Background="#3498db"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#2980b9"
                        Cursor="Hand"
                        Click="PersonalStatsButton_Click"/>

                <!-- High Scores Table Button -->
                <Button Name="HighScoresButton"
                        Content="High Scores Table"
                        Height="40"
                        Width="200"
                        Background="#2ecc71"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderBrush="#27ae60"
                        Cursor="Hand"
                        Click="HighScoresButton_Click"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
